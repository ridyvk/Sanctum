{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-capability",
  "description": "Android picker access and temporary encrypted exports",
  "platforms": ["android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": ["$APPLOCALDATA/imports/*", "$APPLOCALDATA/exports/*"]
    }
  ]
}
